# Copy this file to .env and fill in ONE of the two blocks. .env is ignored by git.

# --- Claude (Anthropic API, official SDK) -----------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high | xhigh | max
LLM_EFFORT=high
# Server-side refusal fallbacks are on by default. Set to "off" so that only LLM_MODEL ever answers.
# LLM_FALLBACKS=off

# --- Any OpenAI-compatible endpoint (Gemini, OpenAI, OpenRouter, vLLM ...) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
